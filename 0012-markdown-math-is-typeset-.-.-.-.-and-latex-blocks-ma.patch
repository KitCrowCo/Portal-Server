@@ -0,0 +1,24 @@
+// Typesets the math the markdown transpiler marked (.md-math: $..$, $$..$$, \(..\), \[..\], ```latex blocks) with KaTeX from /static/js/katex.
+// KaTeX is loaded only on the first page content that has math; a formula KaTeX cannot read stays as its source text.
+(function () {
+    var loading = null;
+    function load() {
+        if (window.katex) return Promise.resolve();
+        if (loading) return loading;
+        var css = document.createElement('link');
+        css.rel = 'stylesheet'; css.href = '/static/js/katex/katex.min.css';
+        document.head.appendChild(css);
+        loading = new Promise(function (ok, fail) { var s = document.createElement('script'); s.src = '/static/js/katex/katex.min.js'; s.onload = ok; s.onerror = fail; document.head.appendChild(s); });
+        return loading;
+    }
+    function run(root) {
+        if (!root.querySelectorAll || !root.querySelector('.md-math:not([data-done])')) return;
+        load().then(function () {
+            root.querySelectorAll('.md-math:not([data-done])').forEach(function (el) {
+                el.dataset.done = 1;
+                try { katex.render(el.textContent, el, {displayMode: el.dataset.display === '1', throwOnError: false}); } catch (e) {}
+            });
+        });
+    }
+    htmx.onLoad(run);
+})();
