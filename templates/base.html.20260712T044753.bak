{#  base.html - Generic nesting shell
    ====================================
    nesting_level (int, default 0)
      0 = standalone page - full html/head/body + global CSS/JS
      1+ = shell fragment - extra_css + shell div + extra_script only
           Route sets this: level = int(request.headers.get("x-shell-level", 0))
    toolbars          dict {side: html} - caller-provided toolbars for the content shell
    content           string, or override via {% block content %} in child template
    code_mirror       bool - load CodeMirror CSS/JS
    PWA               bool - register service worker + manifest
      manifest_path     string - full <link> tag html if non-default manifest
      service_worker    string - custom SW registration JS if non-default
    extra_css         string - module-specific styles (injected at any level)
    extra_script      string - module-specific JS (injected at any level)
    extra_header      string - additional <head> content
    main_left_toolbar string - additional HTML injected into the main sidebar nav #}

{%- set lvl = (nesting_level|default(0))|int -%}
{%- set shell_uuid = "root" if lvl == 0 else (shell_id|default("shell-" ~ range(100000,999999)|random|string)) -%}
{% if lvl == 0 %}
    <!DOCTYPE html>
    <html lang="en">
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1.0">
            <title>{{ title or os.getenv("SERVER_NAME", "Portal Server") }}</title>
            <link rel="icon" type="image/png" href="/static/icon-192.png">

            {% if PWA %}
                {% if manifest_path %}
                    {{ manifest_path|safe }}
                {% else %}
                    <link rel="manifest" href="/static/manifest.json">
                {% endif %}
                <meta name="mobile-web-app-capable" content="yes">
            {% endif %}

            <!--  THEME - server-injected before first paint. No flash, no JS race.  -->
            <style id="theme-root-vars">
            	{% set active_theme = theme.copy() %}
				{% if user and user.custom_theme %}{% set _ = active_theme.update(user.custom_theme) %}{% endif %}

                @font-face { font-family:'Bitter'; src:url('/static/fonts/Bitter/Bitter-Regular.ttf'); }
                @font-face { font-family:'Inter'; src:url('/static/fonts/Inter/Inter-Regular.ttf'); }
                @font-face { font-family:'JetBrains Mono'; src:url('/static/fonts/JetBrainsMono/JetBrainsMono-Regular.ttf'); }
                :root {
                    {% for key, val in active_theme.items() %}--{{ key }}: {{ val }};{% endfor %}
                    --font-main: 'Inter', sans-serif;
                    --font-display: 'Bitter', serif;
                    --font-mono: 'JetBrains Mono', monospace;
                    --toolbar-recall-btn-offset: 0.2rem;
                    --border-thick: 0.1rem;
                    --cm-accent: #00d4ff;
                }
            </style>

            <!--  htmx in <head> so hx-* attrs on body resolve before first paint  -->
            <script src="/static/js/htmx.min.js"></script>
            <script src="/static/js/ws.js"></script>
            <script src="/static/js/interface_bridge.js"></script>

            {% if code_mirror %}
                <link rel="stylesheet" href="/static/js/codemirror/codemirror.css">
                <script src="/static/js/codemirror/lib-codemirror.js"></script>
                <script src="/static/js/codemirror/addon-overlay.js"></script>
                <script src="/static/js/codemirror/mode-python.js"></script>
                <script src="/static/js/codemirror/mode-javascript.js"></script>
            {% endif %}

            {% if extra_header %}{{ extra_header|safe }}{% endif %}
        </head>

        <body>
            <style>
                {% if extra_css %}{{ extra_css|safe }}{% endif %}
                {% include "style.css" %}
            </style>

            <!-- -- App shell -- -->
            <main class="app-shell" data-shell="-1" style="flex:1; min-height:0;">
                <!-- Input bridge - grid-area:bottom -->
                {% set accessibility_toolbar_content %}
                    <div id="im-bridge-outer">
                        <button id="im-bridge-toggle" onclick="IB.toggle()" title="Input Bridge - universal action toolbar">&#x2303; Bridge</button>
                        <span id="im-status-bar"></span>
                        <div id="im-bridge-wrapper"><div id="im-bridge-bar"></div></div>
                    </div>
                    <div id="im-bridge-state" style="display:none;"></div>
                {% endset %}

                {{ UI.toolbar(side="bottom", content=accessibility_toolbar_content, size="3rem", overlay=False, id="accessibility_toolbar", resizable=True)|safe }}
                {{ UI.icon_button("&#x25CE", cmd = "document.body.classList.toggle('recall-hidden')", id = "master-accessibility-btn", hint="Toggle toolbar recall buttons")|safe }}

                {% if user %}
                    {% set main_sidebar_content %}
                        <div class='sb-user-card'>
                            <span class='sb-username'>{{ user.username }}</span>
                            <span class='sb-role'>{{ user.role }}</span>
                        </div>
                        {% if main_left_toolbar %}{{ main_left_toolbar|safe }}{% endif %}
                        <div style='border-top:0.1rem solid var(--border); padding:1rem 0;'>
                            <a href='/logout' class='nav-link' style='opacity:0.7;'>Logout</a>
                        </div>
                    {% endset %}
                    {{ UI.toolbar(side="left", content=main_sidebar_content, size="18rem", overlay=True, id="Main-left-bar", resizable=True, nesting_level = -1)|safe }}
                {% endif %}

<!-- Not an orphan, just splits html tags, this is for the first 'if lvl == 0' -->
{% endif %}
            {% if lvl > 0 and extra_css %}
                <style>
                    {{ extra_css|safe }}
                    {% if code_mirror %}
                        .CodeMirror {background:var(--surface) !important; color:var(--text) !important; font-family:var(--font-mono) !important;}
                        .CodeMirror-gutters {background:var(--bg_panel) !important; border-right:var(--border-thick) solid var(--border);}
                        .CodeMirror-cursor {border-left:var(--border-thick) solid var(--accent) !important;}
                        .cm-s-default .cm-keyword {color:var(--cm-accent) !important;}
                        .cm-s-default .cm-comment {color:var(--text_muted) !important; font-style:italic !important;}
                        .cm-s-default .cm-type    {color:#4ec9b0 !important;}
                        .cm-s-default .cm-string  {color:#7600ff !important;}
                        .cm-s-default .cm-number  {color:#b5cea8 !important;}
                        .cm-s-default .cm-def     {color:#9cdcfe !important;}
                        .cm-s-default .cm-variable{color:#c8e0f0 !important;}
                        .cm-s-default .cm-builtin {color:#4ec9b0 !important;}
                        .cm-s-default .cm-atom    {color:#a8d8a8 !important;}
                        .CodeMirror-selected {background:rgba(100,180,255,0.2) !important;}
                        .CodeMirror-linenumber {color:var(--text_muted) !important;}
                    {% endif %}
                </style>
            {% endif %}
            <div class="app-shell" data-shell="{{ lvl }}" data-im-scope="{{ shell_uuid }}" style="height:100%; width:100%; position:relative; grid-area:center;{% if theme_diff %}{% for k,v in theme_diff.items() %}--{{ k }}: {{ v }};{% endfor %}{% endif %}">
            <!-- <div class="app-shell" data-shell="{{ lvl }}" data-im-scope="{{ shell_uuid }}" style="height:100%; width:100%; position:relative; grid-area:center;" > -->
                {% if toolbars %}{% for _,v in toolbars.items() %}{{ v|safe }}{% endfor %}{% endif %}
                <div id="content-{{ shell_uuid }}" class="content">
                    {% block content %}{{ content|safe }}{% endblock %}
                </div>
	        </div>
            {% if lvl > 0 %}
                <script>
                    {% if extra_script %}{{ extra_script|safe }}{% endif %}
                    if (typeof updateLayout === 'function') { updateLayout(); repositionRecallBtns(); }
                </script>
            {% endif %}

{% if lvl == 0 %}
            </main>

    	    <script>
                {% if PWA %}
                    {% if service_worker %}
                        {{ service_worker|safe }}
                    {% else %}
                        if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js', {scope:'/'}).catch(e => console.warn('SW:', e));
                    {% endif %}
                {% endif %}
                htmx.config.allowScriptTags = true;

                function repositionRecallBtns() {
                    var bySide = {};
                    document.querySelectorAll('.toolbar-recall-btn[id^="btn-"]').forEach(function(btn) {
                        var bar = document.getElementById(btn.id.slice(4));
                        if (!bar) return;
                        var side = bar.dataset.side || 'left';
                        (bySide[side] = bySide[side] || []).push({btn: btn, bar: bar});
                    });
                    Object.entries(bySide).forEach(function([side, items]) {
                        items.forEach(function(item, idx) {
                            var isOpen = item.bar.classList.contains('active');
                            var size = item.bar.dataset.size || '18rem';
                            var off = 'calc(0.2rem + ' + (idx * 1.5) + 'rem)';
                            if (side === 'left') { item.btn.style.top = off; item.btn.style.left = isOpen ? 'calc('+size+' + 0.5rem)' : '0.2rem'; }
                            if (side === 'right') { item.btn.style.bottom = off; item.btn.style.right  = isOpen ? 'calc('+size+' + 0.5rem)' : '0.2rem'; }
                            if (side === 'top') { item.btn.style.right = off; item.btn.style.top = isOpen ? 'calc('+size+' + 0.5rem)' : '0.2rem'; }
                            if (side === 'bottom') { item.btn.style.left = off; item.btn.style.bottom = isOpen ? 'calc('+size+' + 0.5rem)' : '0.2rem'; }
                        });
                    });
                }

                function UI_closeModal(id) { var el = document.getElementById('backdrop-' + id); if (el) el.remove(); }

                function toggleToolbar(id, side, size, mode, arrowOpen, arrowClosed) {
                    const bar = document.getElementById(id);
                    const btn = document.getElementById('btn-' + id);
                    const isOpen = bar.classList.toggle('active');
                    bar.dataset.side = side; bar.dataset.size = size; bar.dataset.mode = mode;
                    if (btn) btn.innerHTML = isOpen ? arrowOpen : arrowClosed;
                    updateLayout(bar.closest('[data-shell]'));
                    repositionRecallBtns();
                }

                function updateLayout(shell) {
                    const targets = shell ? [shell] : document.querySelectorAll('[data-shell]');
                    targets.forEach(function(s) {
                        const sz = {left:'0px', right:'0px', top:'0px', bottom:'0px'};
                        s.querySelectorAll(':scope > .toolbar').forEach(function(bar) { if (!bar.classList.contains('active') || bar.dataset.mode === 'overlay') return; sz[bar.dataset.side] = bar.dataset.size; });
                        for (const [k,v] of Object.entries(sz)) s.style.setProperty('--' + k + '-size', v);
                    });
                }

                {% if extra_script %}{{ extra_script|safe }}{% endif %}
                updateLayout();
				repositionRecallBtns();
				document.addEventListener('htmx:afterSwap', function() { repositionRecallBtns(); updateLayout(); });

                (function(){
                    var proto = location.protocol === 'https:' ? 'wss' : 'ws';
                    var _reconnectDelay = 1000;
                    function _connectWS() {
                        var socket = new WebSocket(proto + '://' + location.host + '/ws');
                        IB.attachWS(socket);
                        socket.addEventListener('close', function(e) {
                            if ([1006, 1012, 1013].indexOf(e.code) >= 0 || e.code === 1001) { setTimeout(function() { _reconnectDelay = Math.min(_reconnectDelay * 1.5, 30000); _connectWS(); }, _reconnectDelay * (0.5 + Math.random())); }
                        });
                        socket.addEventListener('open', function() { _reconnectDelay = 1000; });
                    }
                    _connectWS();
                })();

                // TEMP until moved to intenput bridge
                document.addEventListener('pointerdown', function(e) { if (e.target.closest('.tree-ctx-menu') || e.target.closest('.tree-ctx-btn')) return; document.querySelectorAll('.tree-ctx-menu').forEach(function(m) { m.style.display = 'none'; }); });
                document.addEventListener('keydown', function(e) { if (e.key !== 'Escape') return; document.querySelectorAll('.tree-ctx-menu').forEach(function(m) { m.style.display = 'none'; }); });

                // portal_init: tells server to seed nav state and push focused trigger for the active tab's content. Includes shell_uuid so server targets the correct content div.
                htmx.ajax('POST', '/im/in', {values: {type: 'portal_init', target: 'content-{{ shell_uuid }}'}, swap: 'none'});
            </script>
        </body>
    </html>
{% endif %}

