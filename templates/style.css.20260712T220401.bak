/* -- Reset & base -- */
*, *::before, *::after { box-sizing: border-box; }

html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    width: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-main);
    font-size: var(--font-size);
    overflow: hidden;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
}

body {
    display: flex;
    flex-direction: column;
    background-image: var(--bg_image);
    background-size: cover;
    background-position: center;
}

.graphviz-wrapper svg { max-width: 100%; height: auto; display: block; margin: 0 auto; }

/* Master accessibility view toggle */
#master-accessibility-btn {
    flex: 0 0 auto;
    position: absolute;
    grid-area: top;
    top: 0.5rem;
    right: 50%;
    width: 1rem;
    height: 1.5rem;
    padding: 0 0.6rem;
    background: none;
    border: none;
    border-left: var(--board-thick) solid var(--border);
    color: var(--text_muted);
    cursor: pointer;
    font-size: var(--font-size);
    white-space: nowrap;
    letter-spacing: 0.05rem;
    z-index: 9999;
    transform: translateX(50%);
}

#master-accessibility-btn:hover { color: var(--accent); background: var(--accent_dim); }

body.recall-hidden .toolbar-recall-btn { opacity: 0 !important; pointer-events: none !important; }

/* -- App shell -- */
.app-shell {
    flex: 1;
    min-height: 0;
    display: grid;
    height: 100%;
    width: 100%;
    grid-template-areas: "top top top" "left center right" "bottom bottom bottom";
    grid-template-columns: var(--left-size, 0px) 1fr var(--right-size, 0px);
    grid-template-rows: var(--top-size, 0px) 1fr var(--bottom-size, 0px);
    transition: grid-template-columns 0.4s ease, grid-template-rows 0.4s ease;
    overflow: hidden;
    position: relative;
}

.content { grid-area: center; overflow: auto; min-height: 0; min-width: 0; }

/* -- Toolbars -- */
.toolbar { visibility:visible; background:var(--bg_panel); backdrop-filter:blur(var(--blur)); -webkit-backdrop-filter:blur(var(--blur)); box-sizing:border-box; display:flex; overflow:hidden; flex-direction:column; position:relative; }
.toolbar-internal { display:flex; flex-direction:column; padding:.1rem; width:100%; flex:1; min-height:0; }

.toolbar.overlay { transition:transform 0.4s cubic-bezier(0.16,1,0.3,1), opacity 0.3s, visibility 0s linear 0.4s; }
.toolbar.overlay.toolbar-left:not(.active) { transform:translateX(-100%); }
.toolbar.overlay.toolbar-right:not(.active) { transform:translateX(100%); }
.toolbar.overlay.toolbar-top:not(.active) { transform:translateY(-100%); }
.toolbar.overlay.toolbar-bottom:not(.active) { transform:translateY(100%); }
.toolbar.overlay:not(.active) { visibility:hidden; }
.toolbar.overlay.active { transform:translate(0,0); }

.toolbar.shrink { transition:transform 0.25s ease, width 0.25s ease, height 0.25s ease; }
.toolbar:not(.active) { visibility:hidden; pointer-events:none; }

.toolbar-recall-btn { width:var(--recall_button_size, 1.5rem); height:var(--recall_button_size, 1.5rem); color:var(--accent); background:var(--accent_dim); border:var(--border-thick) solid var(--border); border-radius:50%; transition:opacity 0.2s; }
.toolbar-recall-btn:hover { background:var(--accent); color:var(--bg); }
.toolbar-inline-close { opacity:0.55; }
.toolbar-inline-close:hover { opacity:1; }

.toolbar-recall-btn {
    width: var(--recall_button_size, .5rem);
    height: var(--recall_button_size, .5rem);
    grid-area: center;
    color: var(--accent);
    background: var(--accent_dim);
    border: var(--border-thick) solid var(--border);
    border-radius: 50%;
    transition: opacity 0.2s;
}

.toolbar-recall-btn:hover { background: var(--accent); color: var(--bg); }

/* -- Shared components -- */
.glass {
    background: var(--glass);
    backdrop-filter: blur(var(--blur));
    -webkit-backdrop-filter: blur(var(--blur));
    border: var(--board-thick) solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--glass-box-shadow);
}

.nav-link { color: var(--text); text-decoration: none; padding: 0.5rem 0; display: block; transition: color 0.2s; cursor: pointer; }
.nav-link:hover { color: var(--accent); }

.close-btn {width: 1.5em; aspect-ratio: 1 / 1; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; line-height: 0; padding: 0; box-sizing: border-box; cursor: pointer; opacity: 0.4; background: transparent; color: var(--text); border: var(--board-thick) solid var(--border); transition: all 0.1s ease; }
.close-btn:hover { opacity: 1; color: var(--accent); border: calc(var(--board-thick) * 1.25) solid var(--accent); font-weight: bold; background: transparent; }
.button { border: var(--board-thick) solid var(--accent); color: var(--accent); padding: 0.5rem; border-radius: var(--radius); cursor: pointer; font-weight: 600; margin-top: .5rem; }
.btn-icon { background: none; border: none; color: var(--text_muted); cursor: pointer; padding: 0.4rem; border-radius: 0.4rem; display: flex; align-items: center; justify-content: center; }
.btn-icon:hover { color: var(--accent); background: var(--accent_dim); }

.ui-btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.8rem; border-radius: var(--radius); border: var(--board-thick) solid var(--border); background: var(--glass); color: var(--text); font-family: var(--font-main); font-weight: 500; cursor: pointer; }
.ui-btn:hover { background: var(--accent_dim); border-color: var(--accent); color: var(--accent); }
.ui-btn.active { background: var(--accent_dim); border-color: var(--accent); color: var(--accent); }
.btn-icon.active { color: var(--accent); background: var(--accent_dim); }

.card:hover { border: var(--board-thick) solid var(--accent); }

.sb-user-card { margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: var(--board-thick) solid var(--border); }
.sb-username { display: block; font-weight: 700; color: var(--text); font-size: calc(var(--font-size) * 1.5); }
.sb-role { font-size: var(--font-size); color: var(--accent); text-transform: uppercase; letter-spacing: 0.1rem; }
.module-select { width: 80%; background: var(--surface); color: var(--text); border: var(--board-thick) solid var(--border); border-radius: calc(var(--radius) / 2); padding: 0.5rem; margin: 1rem 0; font-family: inherit; }

/* -- Tab system -- */
.tab-bar { display: flex; overflow-x: auto; background: var(--bg_panel); border-bottom: var(--board-thick) solid var(--border); scrollbar-width: none; }
.tab { padding: 0.5rem; border-right: var(--board-thick) solid var(--border); cursor: pointer; display: flex; align-items: center; white-space: nowrap; background: transparent; font-size: calc(var(--font-size) * 0.9); }
.tab.active { background: var(--glass); border-bottom: var(--board-thick) solid var(--accent); color: var(--accent); }
.tab-bar::-webkit-scrollbar { display: none; }

/* -- htmx in process -- */
.htmx-indicator { opacity: 0; transition: opacity .15s ease; pointer-events: none; }
.htmx-request .htmx-indicator, .htmx-request.htmx-indicator { opacity: 1; }
@keyframes spin { to { transform: rotate(360deg); } }
.spin { display: inline-block; animation: spin .7s linear infinite; }

/* -- Input bridge -- */
#im-bridge-outer { grid-area: bottom; display: flex; align-items: center; background: var(--bg_panel); border-top: var(--board-thick) solid var(--border); min-height: 2.2rem; flex-shrink: 0; z-index: 900; overflow: hidden; }
#im-bridge-wrapper { display: none; flex: 1; overflow-x: auto; min-width: 0; }
#im-bridge-toggle { padding: 0.2rem 0.6rem; background: none; border: none; border-right: var(--board-thick) solid var(--border); cursor: pointer; color: var(--text_muted); font-size: calc(var(--font-size) * 0.9); align-self: stretch; white-space: nowrap; flex-shrink: 0; }
#im-bridge-toggle:hover { color: var(--accent); background: var(--accent_dim); }
#im-status-bar { flex: 1; padding: 0 0.6rem; font-size: calc(var(--font-size) * 0.8); color: var(--text_muted); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.im-status-ok { color: var(--accent); }
.im-status-warn { color: #ffaa44; }
.im-status-error { color: #ff5f5f; }

details[open] > summary > .tree-caret { transform: rotate(90deg); }
.tree-fs-row:hover .tree-ctx-btn { opacity: 1; }
.tree-ctx-menu { font-size: .72rem; }
.tree-fs-row.tree-active, details.tree-active > summary.tree-fs-row { background: var(--accent_dim); }
.tree-leaf.tree-active, details.tree-active > summary.tree-summary { background: var(--accent_dim); color: var(--accent); }
.tree-cb-partial { background: linear-gradient(135deg, transparent 45%, var(--text_muted) 45%, var(--text_muted) 55%, transparent 55%); }

input[type=file]::file-selector-button {}
